{
  "name": "study-buddy-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.22.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "overrides": {
    "katex": "$katex",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:policy": "node scripts/check-test-policy.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:e2e:prepare": "node scripts/prepare-e2e-database.mjs",
    "test:e2e": "playwright test --config=playwright.e2e.config.ts",
    "verify:node-runtime": "node scripts/verify-node-runtime.mjs",
    "resources:migrate-past-questions": "tsx scripts/migrate-past-questions-to-resources.ts",
    "resources:rebuild-search-text": "tsx scripts/rebuild-resource-search-text.ts",
    "resources:embed-chunks": "tsx scripts/embed-resource-chunks.ts",
    "resources:search": "tsx scripts/search-resources.ts",
    "resources:evaluate-retrieval": "tsx scripts/evaluate-retrieval.ts",
    "ai:evaluate-grounding": "tsx scripts/evaluate-grounded-chat.ts",
    "cron:account-lifecycle": "node scripts/run-account-lifecycle-cron.mjs",
    "cron:security-operations-report": "node scripts/run-security-operations-report.mjs",
    "security:verify-database": "tsx scripts/verify-database-security.ts",
    "security:audit-dependencies": "node scripts/check-npm-audit.mjs",
    "security:backfill-auth-email-fingerprints": "tsx scripts/backfill-auth-email-fingerprints.ts",
    "security:record-operations-evidence": "node scripts/record-security-operations-evidence.mjs"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^2.2.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@prisma/client": "5.17.0",
    "@streamdown/math": "^1.0.4",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "autoprefixer": "^10.7.0",
    "highlight.js": "^11.12.0",
    "katex": "0.19.1",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "openai": "7.62.0",
    "pg": "8.23.1",
    "postcss": "^8.5.33",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "5.7.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "streamdown": "^2.8.0",
    "tailwindcss": "^3.4.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "18.2.55",
    "@types/react-dom": "18.2.18",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "prisma": "5.17.0",
    "ts-node": "10.9.2",
    "tsx": "^4.23.13",
    "typescript": "5.3.3",
    "vitest": "4.1.12"
  }
}
