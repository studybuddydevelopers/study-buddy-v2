// prisma/schema.prisma

// =========================================================
//  GENERATOR & DATASOURCE
// =========================================================

generator client {
  provider = "prisma-client-js"
  // output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================================
//  ENUMS
// =========================================================

enum Sender {
  user
  ai
}

enum AiChatRole {
  USER
  ASSISTANT
}

enum AiChatMessageStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AiGenerationRequestStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AiGenerationFailureCode {
  PROVIDER_TIMEOUT
  RATE_LIMITED
  PROVIDER_ERROR
  INVALID_PROVIDER_RESPONSE
  UNSUPPORTED_GENERATED_CLAIM
  INTERNAL_ERROR
}

enum AiGroundingSufficiencyStatus {
  SUFFICIENT
  INSUFFICIENT
}

enum AiGroundingSufficiencyReason {
  SUPPORTED
  NO_RESULTS
  LOW_RELEVANCE
  FILTERED_CORPUS_GAP
  POSSIBLE_CONFLICT
  MISSING_REQUIRED_SOURCE_TYPE
}

enum AiGroundingConfidence {
  HIGH
  MEDIUM
  LOW
}

enum ResourceSourceKind {
  UPLOAD
  LEGACY_PAST_QUESTION
}

enum ResourceProcessingStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum ResourceApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ResourceExtractionQuality {
  HIGH
  MEDIUM
  LOW
  FAILED
}

enum ResourceChunkType {
  CONTENT_SECTION
  PAST_QUESTION
  MARK_SCHEME
  WORKED_SOLUTION
  SYLLABUS_OBJECTIVE
  FORMULA_REFERENCE
}

enum ResourceEmbeddingConfigurationStatus {
  BUILDING
  READY
  ACTIVE
  RETIRED
  FAILED
}

enum ResourceChunkEmbeddingStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ResourceChunkEmbeddingFailureCode {
  PROVIDER_TIMEOUT
  RATE_LIMITED
  PROVIDER_ERROR
  INVALID_PROVIDER_RESPONSE
  DIMENSION_MISMATCH
  INTERNAL_ERROR
}

enum SubscriptionPlan {
  free
  premium
}

enum SubscriptionStatus {
  active
  expired
  canceled
}

enum AccountStatus {
  AGE_VERIFICATION_REQUIRED
  BELOW_MINIMUM_AGE
  GUARDIAN_AUTHORIZATION_REQUIRED
  ACTIVE
  GUARDIAN_AUTHORIZATION_DENIED
  DEACTIVATED
  DELETION_PENDING
}

enum AccountDeletionRequestStatus {
  AWAITING_CONFIRMATION
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum GuardianRelationship {
  PARENT
  LEGAL_GUARDIAN
}

enum GuardianAuthorizationStatus {
  PENDING
  GRANTED
  DENIED
  WITHDRAWN
  EXPIRED
  SUPERSEDED
}

enum GuardianAuthorizationEventType {
  REQUESTED
  GRANTED
  DENIED
  WITHDRAWN
  EXPIRED
  SUPERSEDED
}

enum PasswordResetSecurityEventType {
  ALERT_REQUESTED
  ALERT_SENT
  ALERT_SUPPRESSED
  ALERT_DELIVERY_FAILED
  LOCK_CONFIRMED
  AUTH_LOCK_APPLIED
  AUTH_LOCK_FAILED
  LOCK_EXPIRED
  RECOVERY_REQUESTED
  RECOVERY_EMAIL_SENT
  RECOVERY_FAILED
  UNLOCKED
}

enum MarkingReviewStatus {
  PENDING
  UPHELD
  MARK_ADJUSTED
}

enum MarkingReviewEventType {
  SUBMITTED
  UPHELD
  MARK_ADJUSTED
}

enum MarkingReviewActorType {
  LEARNER
  SUPPORT
}

// =========================================================
//  AUTH & USER PROFILES
// =========================================================

model User {
  id                      String        @id @default(uuid())
  createdAt               DateTime      @default(now())
  whatsappPhone           String?       @unique // wa_id, digits only e.g. "2348012345678" — set for WhatsApp-only accounts
  accountStatus           AccountStatus @default(AGE_VERIFICATION_REQUIRED)
  aiAccessAuthorized      Boolean       @default(false)
  termsAcceptedAt         DateTime?
  termsVersion            String?       @db.VarChar(32)
  deactivatedAt           DateTime?
  inactiveDeletionAt      DateTime?
  inactiveWarning90SentAt DateTime?
  inactiveWarning60SentAt DateTime?
  inactiveWarning15SentAt DateTime?
  inactiveWarning1SentAt  DateTime?
  authEmailFingerprint    String?       @unique @db.VarChar(64)

  profile                     UserProfile?
  settings                    UserSettings?
  aiChats                     AiChat[]
  aiQuestions                 AiQuestion[]
  attempts                    PastQuestionAttempt[]
  practiceDrafts              PracticeAnswerDraft[]
  practiceSessions            PracticeQuizSession[]
  mockExams                   MockExamInstance[]
  recommendations             Recommendation[]
  aiDailyUsage                AiDailyUsage[]
  progress                    ProgressTrack[]
  subscriptions               Subscription[]
  transactions                Transaction[]
  guardianAuthorizations      GuardianAuthorization[]
  deletionRequest             AccountDeletionRequest?
  uploadedResources           Resource[]                   @relation("ResourceUploadedBy")
  approvedResources           Resource[]                   @relation("ResourceApprovedBy")
  passwordResetSecurityState  PasswordResetSecurityState?
  passwordResetSecurityEvents PasswordResetSecurityEvent[]
  markingReviewsSubmitted     MockExamMarkingReview[]      @relation("MarkingReviewSubmittedBy")
  markingReviewsResolved      MockExamMarkingReview[]      @relation("MarkingReviewResolvedBy")
  markingReviewEventsActed    MockExamMarkingReviewEvent[] @relation("MarkingReviewEventActor")

  @@index([createdAt], map: "User_createdAt_idx")
  @@index([accountStatus, inactiveDeletionAt], map: "User_accountStatus_inactiveDeletionAt_idx")
}

/// One row per account. Raw email addresses and bearer tokens are deliberately
/// excluded; only keyed email and one-way token hashes are persisted.
model PasswordResetSecurityState {
  userId                 String    @id
  lastAlertAttemptAt     DateTime?
  lastAlertSentAt        DateTime?
  alertDay               DateTime? @db.Date
  alertCount             Int       @default(0)
  lockTokenHash          String?   @unique @db.VarChar(64)
  lockTokenExpiresAt     DateTime?
  lockTokenUsedAt        DateTime?
  lockedAt               DateTime?
  lockedUntil            DateTime?
  lockExpiryRecordedAt   DateTime?
  authLockAppliedAt      DateTime?
  recoveryTokenHash      String?   @unique @db.VarChar(64)
  recoveryTokenExpiresAt DateTime?
  recoveryTokenUsedAt    DateTime?
  recoveryStartedAt      DateTime?
  recoveryCompletedAt    DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lockedUntil], map: "PasswordResetSecurityState_lockedUntil_idx")
  @@index([recoveryTokenExpiresAt], map: "PasswordResetSecurityState_recoveryTokenExpiry_idx")
}

model PasswordResetSecurityEvent {
  id        String                         @id @default(uuid())
  userId    String
  eventType PasswordResetSecurityEventType
  details   Json?
  createdAt DateTime                       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "PasswordResetSecurityEvent_user_created_idx")
}

/// Minimal, retryable evidence and work queue for permanent account deletion.
/// Direct identifiers are cleared after both the application account and the
/// Supabase Auth identity have been removed.
model AccountDeletionRequest {
  id                         String                       @id @default(uuid())
  userId                     String?                      @unique
  authUserId                 String?                      @unique
  accountFingerprint         String                       @db.VarChar(64)
  status                     AccountDeletionRequestStatus @default(AWAITING_CONFIRMATION)
  requestedAt                DateTime                     @default(now())
  confirmationSentAt         DateTime?
  confirmationTokenHash      String?                      @unique @db.VarChar(64)
  confirmationTokenExpiresAt DateTime?
  confirmedAt                DateTime?
  retentionTriggeredAt       DateTime?
  scheduledFor               DateTime?
  processingStartedAt        DateTime?
  completedAt                DateTime?
  cancelledAt                DateTime?
  attemptCount               Int                          @default(0)
  lastFailureCode            String?                      @db.VarChar(64)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor], map: "AccountDeletionRequest_status_scheduled_idx")
  @@index([confirmationTokenExpiresAt], map: "AccountDeletionRequest_confirmation_expiry_idx")
}

// =========================================================
//  SECURITY + ABUSE CONTROLS
// =========================================================

model RateLimitBucket {
  id          String   @id @db.VarChar(64)
  scope       String   @db.VarChar(96)
  count       Int      @default(1)
  windowStart DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt], map: "RateLimitBucket_expiresAt_idx")
}

model AiDailyUsage {
  userId       String
  usageDate    DateTime @db.Date
  requestCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, usageDate])
  @@index([usageDate], map: "AiDailyUsage_usageDate_idx")
}

/// One row per UTC day. Provider calls reserve an upper-bound token amount
/// before execution, then replace the reservation with reported usage.
model AiGlobalDailyUsage {
  usageDate      DateTime @id @db.Date
  reservedTokens Int      @default(0)
  consumedTokens Int      @default(0)
  requestCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Privacy-safe application security events retained for operational review.
/// Callers must use pseudonyms rather than raw account, email, IP, or token data.
model SecurityAuditEvent {
  id          BigInt   @id @default(autoincrement())
  event       String   @db.VarChar(96)
  level       String   @db.VarChar(16)
  details     Json?
  environment String?  @db.VarChar(64)
  service     String?  @db.VarChar(96)
  createdAt   DateTime @default(now())

  @@index([createdAt], map: "SecurityAuditEvent_createdAt_idx")
  @@index([event, level, createdAt], map: "SecurityAuditEvent_event_level_createdAt_idx")
}

/// Evidence that requires a controlled human action, such as restoring a
/// backup into an isolated environment or reviewing provider account access.
model SecurityOperationsEvidence {
  evidenceType String   @id @db.VarChar(64)
  verifiedAt   DateTime
  reviewedBy   String?  @db.VarChar(160)
  reference    String?  @db.VarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Idempotency and delivery evidence for the monthly security-operations email.
model SecurityOperationsReportRun {
  id          String    @id @default(uuid())
  periodStart DateTime
  periodEnd   DateTime
  status      String    @db.VarChar(24)
  recipients  String[]
  summary     Json?
  sentAt      DateTime?
  failureCode String?   @db.VarChar(64)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([periodStart, periodEnd], map: "SecurityOperationsReportRun_period_key")
  @@index([status, createdAt], map: "SecurityOperationsReportRun_status_createdAt_idx")
}

model UserProfile {
  userId            String    @id
  firstName         String
  middleNames       String?
  lastNames         String
  phoneNumber       String
  gradeLevel        String?
  examYear          Int?
  preferredSubjects String[] // fixed: no optional list
  avatarUrl         String?
  dateOfBirth       DateTime? @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GuardianAuthorization {
  id                 String                      @id @default(uuid())
  studentUserId      String
  studentEmail       String                      @db.VarChar(320)
  guardianName       String                      @db.VarChar(160)
  guardianEmail      String                      @db.VarChar(320)
  relationship       GuardianRelationship
  status             GuardianAuthorizationStatus @default(PENDING)
  tokenHash          String                      @unique @db.VarChar(64)
  tokenExpiresAt     DateTime
  noticeVersion      String                      @db.VarChar(32)
  termsVersion       String                      @db.VarChar(32)
  verificationMethod String                      @default("EMAIL_LINK_DECLARATION") @db.VarChar(64)
  aiAuthorized       Boolean?
  requestedAt        DateTime                    @default(now())
  decidedAt          DateTime?
  withdrawnAt        DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  student User                         @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  events  GuardianAuthorizationEvent[]

  @@index([studentUserId, status, createdAt], map: "GuardianAuthorization_student_status_idx")
  @@index([guardianEmail, status], map: "GuardianAuthorization_guardian_status_idx")
  @@index([tokenExpiresAt], map: "GuardianAuthorization_token_expiry_idx")
}

model GuardianAuthorizationEvent {
  id              String                         @id @default(uuid())
  authorizationId String
  eventType       GuardianAuthorizationEventType
  actorType       String                         @db.VarChar(32)
  ipFingerprint   String?                        @db.VarChar(64)
  details         Json?
  createdAt       DateTime                       @default(now())

  authorization GuardianAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)

  @@index([authorizationId, createdAt], map: "GuardianAuthorizationEvent_authorization_created_idx")
}

model UserSettings {
  userId                     String   @id
  cloudPracticeDraftsEnabled Boolean  @default(false)
  lowDataModeEnabled         Boolean  @default(false)
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =========================================================
//  SUBJECTS & TOPICS
// =========================================================

model Subject {
  id          String  @id @default(uuid())
  name        String
  examCode    String?
  description String?

  topics          Topic[]
  mockTemplates   MockExamTemplate[]
  pastQuestions   PastQuestion[]
  curriculumFiles CurriculumFile[]
  resources       Resource[]
  resourceChunks  ResourceChunk[]
  progressTracks  ProgressTrack[]
  aiChats         AiChat[]
  aiQuestions     AiQuestion[]
  recommendations Recommendation[]

  @@index([examCode], map: "Subject_examCode_idx")
}

model Topic {
  id             String  @id @default(uuid())
  subjectId      String
  title          String
  examOutlineRef String?
  difficulty     Int?
  sortOrder      Int     @default(0)

  subject          Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  pastQuestions    PastQuestion[]
  resources        Resource[]
  resourceChunks   ResourceChunk[]
  recommendations  Recommendation[]
  aiChats          AiChat[]
  aiQuestions      AiQuestion[]
  practiceSessions PracticeQuizSession[]

  @@index([subjectId, sortOrder, title], map: "Topic_subjectId_sortOrder_title_idx")
}

// =========================================================
//  PAST QUESTIONS
// =========================================================

model PastQuestion {
  id               String  @id @default(uuid())
  subjectId        String
  topicId          String?
  questionText     String
  questionImageUrl String?
  answerText       String
  explanationText  String?
  year             Int?
  questionNumber   String?
  difficulty       Int?

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  attempts         PastQuestionAttempt[]
  drafts           PracticeAnswerDraft[]
  quizAnswers      PracticeQuizAnswer[]
  mockAnswers      MockExamAnswer[]
  migratedResource Resource?

  @@index([topicId, difficulty, id], map: "PastQuestion_topicId_difficulty_id_idx")
  @@index([subjectId, id], map: "PastQuestion_subjectId_id_idx")
}

model PracticeAnswerDraft {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  answerText String
  updatedAt  DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question PastQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, updatedAt])
}

// =========================================================
//  USER PAST QUESTION ATTEMPTS
// =========================================================

model PastQuestionAttempt {
  id               String   @id @default(uuid())
  userId           String
  questionId       String
  userAnswer       String?
  isCorrect        Boolean
  score            Int?
  timeTakenSeconds Int?
  attemptedAt      DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question PastQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, attemptedAt], map: "PastQuestionAttempt_userId_attemptedAt_idx")
  @@index([userId, questionId, attemptedAt], map: "PastQuestionAttempt_userId_questionId_attemptedAt_idx")
}

model PracticeQuizSession {
  id                 String   @id @default(uuid())
  userId             String
  topicId            String?
  startedAt          DateTime
  finishedAt         DateTime @default(now())
  durationSeconds    Int?
  totalQuestions     Int
  answeredQuestions  Int
  submittedQuestions Int
  correctQuestions   Int
  wrongQuestions     Int

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic   Topic?               @relation(fields: [topicId], references: [id], onDelete: SetNull)
  answers PracticeQuizAnswer[]

  @@index([userId, finishedAt])
  @@index([topicId, finishedAt])
}

model PracticeQuizAnswer {
  id          String    @id @default(uuid())
  sessionId   String
  questionId  String
  answerText  String?
  submitted   Boolean   @default(false)
  isCorrect   Boolean?
  answeredAt  DateTime?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  session  PracticeQuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question PastQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([questionId])
}

// =========================================================
//  AI Q&A SYSTEM
// =========================================================

model AiQuestion {
  id           String   @id @default(uuid())
  userId       String
  subjectId    String?
  topicId      String?
  questionText String
  createdAt    DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  messages AiQuestionMessage[]

  @@index([userId, createdAt], map: "AiQuestion_userId_createdAt_idx")
}

model AiQuestionMessage {
  id           String   @id @default(uuid())
  aiQuestionId String
  sender       Sender
  message      String
  createdAt    DateTime @default(now())

  aiQuestion AiQuestion @relation(fields: [aiQuestionId], references: [id], onDelete: Cascade)

  @@index([aiQuestionId, createdAt], map: "AiQuestionMessage_aiQuestionId_createdAt_idx")
}

model AiChat {
  id        String    @id @default(uuid())
  userId    String
  title     String
  subjectId String?
  topicId   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  messages           AiChatMessage[]
  generationRequests AiGenerationRequest[]

  @@index([userId, deletedAt, updatedAt, id], map: "AiChat_userId_deletedAt_updatedAt_id_idx")
  @@index([id, userId, deletedAt], map: "AiChat_id_userId_deletedAt_idx")
}

model AiChatMessage {
  id                        String                   @id @default(uuid())
  chatId                    String
  role                      AiChatRole
  content                   String
  status                    AiChatMessageStatus      @default(COMPLETED)
  failureCode               AiGenerationFailureCode?
  modelProvider             String?
  modelName                 String?
  inputTokens               Int?
  outputTokens              Int?
  currentGroundingAttemptId String?                  @unique(map: "AiChatMessage_currentGroundingAttemptId_key")
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  chat AiChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  userGenerationRequest      AiGenerationRequest? @relation("AiGenerationUserMessage")
  assistantGenerationRequest AiGenerationRequest? @relation("AiGenerationAssistantMessage")
  groundingAttempts          AiGroundingAttempt[] @relation("AiGroundingAssistantMessage")
  currentGroundingAttempt    AiGroundingAttempt?  @relation("AiMessageCurrentGroundingAttempt", fields: [currentGroundingAttemptId], references: [id], onDelete: SetNull)
  citations                  AiMessageCitation[]

  @@index([chatId, createdAt, id], map: "AiChatMessage_chatId_createdAt_id_idx")
}

model AiGenerationRequest {
  id                 String                    @id @default(uuid())
  chatId             String
  clientRequestId    String
  userMessageId      String                    @unique(map: "AiGenerationRequest_userMessageId_key")
  assistantMessageId String                    @unique(map: "AiGenerationRequest_assistantMessageId_key")
  status             AiGenerationRequestStatus @default(PENDING)
  attemptCount       Int                       @default(1)
  failureCode        AiGenerationFailureCode?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  completedAt        DateTime?

  chat             AiChat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userMessage      AiChatMessage @relation("AiGenerationUserMessage", fields: [userMessageId], references: [id], onDelete: Cascade)
  assistantMessage AiChatMessage @relation("AiGenerationAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: Cascade)

  groundingAttempts AiGroundingAttempt[]

  @@unique([chatId, clientRequestId], map: "AiGenerationRequest_chatId_clientRequestId_key")
  @@index([chatId, status, updatedAt], map: "AiGenerationRequest_chatId_status_updatedAt_idx")
}

model AiGroundingAttempt {
  id                       String                       @id @default(uuid())
  generationRequestId      String
  assistantMessageId       String
  attemptNumber            Int
  retrievalQuery           String
  embeddingConfigurationId String?
  sufficiencyStatus        AiGroundingSufficiencyStatus
  sufficiencyReason        AiGroundingSufficiencyReason
  confidence               AiGroundingConfidence
  selectedEvidenceMetadata Json
  groundingVersion         String
  promptVersion            String
  sufficiencyPolicyVersion String
  retrievalDurationMs      Int?
  generationDurationMs     Int?
  createdAt                DateTime                     @default(now())

  generationRequest      AiGenerationRequest             @relation(fields: [generationRequestId], references: [id], onDelete: Cascade)
  assistantMessage       AiChatMessage                   @relation("AiGroundingAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: Cascade)
  embeddingConfiguration ResourceEmbeddingConfiguration? @relation(fields: [embeddingConfigurationId], references: [id], onDelete: SetNull)
  currentForMessage      AiChatMessage?                  @relation("AiMessageCurrentGroundingAttempt")
  citations              AiMessageCitation[]

  @@unique([generationRequestId, attemptNumber], map: "AiGroundingAttempt_request_attemptNumber_key")
  @@index([assistantMessageId, createdAt, id], map: "AiGroundingAttempt_assistant_createdAt_id_idx")
  @@index([embeddingConfigurationId], map: "AiGroundingAttempt_embeddingConfigurationId_idx")
}

model AiMessageCitation {
  id                 String   @id @default(uuid())
  groundingAttemptId String
  messageId          String
  resourceId         String
  resourceChunkId    String
  sourceLabel        String
  retrievalRank      Int?
  vectorDistance     Float?
  keywordRank        Int?
  fusionScore        Float?
  contentHash        String
  createdAt          DateTime @default(now())

  groundingAttempt AiGroundingAttempt @relation(fields: [groundingAttemptId], references: [id], onDelete: Cascade)
  message          AiChatMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  resource         Resource           @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceChunk    ResourceChunk      @relation(fields: [resourceChunkId], references: [id], onDelete: Cascade)

  @@unique([groundingAttemptId, sourceLabel], map: "AiMessageCitation_attempt_sourceLabel_key")
  @@unique([groundingAttemptId, resourceChunkId, contentHash], map: "AiMessageCitation_attempt_chunk_hash_key")
  @@index([messageId, createdAt, id], map: "AiMessageCitation_message_createdAt_id_idx")
  @@index([resourceId], map: "AiMessageCitation_resourceId_idx")
  @@index([resourceChunkId], map: "AiMessageCitation_resourceChunkId_idx")
}

// =========================================================
//  MOCK EXAMS
// =========================================================

enum MockExamFormat {
  OBJECTIVE
  WRITTEN
}

enum MockExamSection {
  OBJECTIVE
  PART_I
  PART_II
}

model MockExamTemplate {
  id                    String         @id @default(uuid())
  subjectId             String
  title                 String
  description           String?
  questionCount         Int
  format                MockExamFormat @default(OBJECTIVE)
  durationMinutes       Int?
  totalMarks            Int?
  requiredQuestionCount Int?

  subject   Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  instances MockExamInstance[]

  @@index([subjectId], map: "MockExamTemplate_subjectId_idx")
}

model MockExamInstance {
  id                 String    @id @default(uuid())
  userId             String
  templateId         String
  startedAt          DateTime  @default(now())
  submittedAt        DateTime?
  totalScore         Int?
  graded             Boolean   @default(false)
  aiCreditReservedAt DateTime?

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  template       MockExamTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  answers        MockExamAnswer[]
  markingReviews MockExamMarkingReview[]

  @@index([userId, graded, submittedAt, startedAt], map: "MockExamInstance_userId_graded_submittedAt_startedAt_idx")
}

model MockExamAnswer {
  id                 String          @id @default(uuid())
  mockExamInstanceId String
  pastQuestionId     String
  userAnswer         String?
  isCorrect          Boolean?
  aiExplanation      String?
  score              Int?
  section            MockExamSection @default(OBJECTIVE)
  displayOrder       Int?
  maxScore           Int             @default(1)

  instance      MockExamInstance       @relation(fields: [mockExamInstanceId], references: [id], onDelete: Cascade)
  question      PastQuestion           @relation(fields: [pastQuestionId], references: [id], onDelete: Cascade)
  markingReview MockExamMarkingReview?

  @@index([mockExamInstanceId], map: "MockExamAnswer_mockExamInstanceId_idx")
}

model MockExamMarkingReview {
  id                        String              @id @default(uuid())
  reference                 String              @unique @db.VarChar(32)
  userId                    String
  mockExamInstanceId        String
  mockExamAnswerId          String              @unique
  status                    MarkingReviewStatus @default(PENDING)
  learnerReason             String              @db.Text
  originalScore             Int
  revisedScore              Int?
  maxScore                  Int
  paperTitleSnapshot        String
  subjectNameSnapshot       String
  questionReferenceSnapshot String
  questionTextSnapshot      String              @db.Text
  learnerAnswerSnapshot     String              @db.Text
  modelAnswerSnapshot       String              @db.Text
  markingGuideSnapshot      String              @db.Text
  aiRationaleSnapshot       String              @db.Text
  resolvedByUserId          String?
  resolutionNote            String?             @db.Text
  submittedAt               DateTime            @default(now())
  resolvedAt                DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  learner  User                         @relation("MarkingReviewSubmittedBy", fields: [userId], references: [id], onDelete: Cascade)
  resolver User?                        @relation("MarkingReviewResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  instance MockExamInstance             @relation(fields: [mockExamInstanceId], references: [id], onDelete: Cascade)
  answer   MockExamAnswer               @relation(fields: [mockExamAnswerId], references: [id], onDelete: Cascade)
  events   MockExamMarkingReviewEvent[]

  @@index([userId, submittedAt], map: "MockExamMarkingReview_user_submitted_idx")
  @@index([status, submittedAt], map: "MockExamMarkingReview_status_submitted_idx")
  @@index([mockExamInstanceId], map: "MockExamMarkingReview_instance_idx")
}

model MockExamMarkingReviewEvent {
  id            String                 @id @default(uuid())
  reviewId      String
  eventType     MarkingReviewEventType
  actorType     MarkingReviewActorType
  actorUserId   String?
  previousScore Int?
  newScore      Int?
  note          String?                @db.Text
  createdAt     DateTime               @default(now())

  review MockExamMarkingReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  actor  User?                 @relation("MarkingReviewEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([reviewId, createdAt], map: "MockExamMarkingReviewEvent_review_created_idx")
}

// =========================================================
//  AI RECOMMENDATIONS
// =========================================================

model Recommendation {
  id                 String   @id @default(uuid())
  userId             String
  subjectId          String?
  topicId            String?
  recommendationText String
  createdAt          DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "Recommendation_userId_createdAt_idx")
}

// =========================================================
//  PROGRESS TRACKING
// =========================================================

model ProgressTrack {
  id                 String   @id @default(uuid())
  userId             String
  subjectId          String
  progressPercentage Int      @default(0)
  updatedAt          DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId], map: "ProgressTrack_userId_subjectId_key")
}

// =========================================================
//  SUBSCRIPTIONS
// =========================================================

model Subscription {
  id            String             @id @default(uuid())
  userId        String
  plan          SubscriptionPlan   @default(free)
  status        SubscriptionStatus @default(active)
  startDate     DateTime           @default(now())
  endDate       DateTime?
  renewalMethod String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate], map: "Subscription_userId_startDate_idx")
  @@index([status, plan, startDate], map: "Subscription_status_plan_startDate_idx")
}

// =========================================================
//  CONTENT MGMT
// =========================================================

model CurriculumFile {
  id         String   @id @default(uuid())
  subjectId  String
  fileUrl    String
  uploadedBy String
  uploadedAt DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Resource {
  id                    String                     @id @default(uuid())
  sourceKind            ResourceSourceKind
  title                 String
  description           String?
  subjectId             String?
  topicId               String?
  uploadedById          String?
  approvedById          String?
  legacyPastQuestionId  String?                    @unique(map: "Resource_legacyPastQuestionId_key")
  storageBucket         String?
  storagePath           String?
  originalFileName      String?
  mimeType              String?
  byteSize              Int?
  contentHash           String
  version               Int                        @default(1)
  activeChunkVersion    Int?
  activeChunkSetHash    String?
  processingVersion     Int?
  processingStatus      ResourceProcessingStatus   @default(UPLOADED)
  approvalStatus        ResourceApprovalStatus     @default(PENDING_REVIEW)
  extractionQuality     ResourceExtractionQuality?
  extractionWarnings    Json?
  provenance            String?
  usageRights           String?
  duplicateOfResourceId String?
  migrationReport       Json?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  processedAt           DateTime?
  failedAt              DateTime?
  failureReason         String?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  approvalNotes         String?

  subject            Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic              Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  uploadedBy         User?         @relation("ResourceUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  approvedBy         User?         @relation("ResourceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  legacyPastQuestion PastQuestion? @relation(fields: [legacyPastQuestionId], references: [id], onDelete: SetNull)
  duplicateOf        Resource?     @relation("ResourceDuplicate", fields: [duplicateOfResourceId], references: [id], onDelete: SetNull)
  duplicates         Resource[]    @relation("ResourceDuplicate")

  chunks    ResourceChunk[]
  citations AiMessageCitation[]

  @@index([approvalStatus, processingStatus, updatedAt, id], map: "Resource_approval_processing_updatedAt_id_idx")
  @@index([subjectId, topicId, approvalStatus], map: "Resource_subjectId_topicId_approval_idx")
  @@index([contentHash, version], map: "Resource_contentHash_version_idx")
  @@index([activeChunkVersion], map: "Resource_activeChunkVersion_idx")
  @@index([sourceKind, updatedAt, id], map: "Resource_sourceKind_updatedAt_id_idx")
}

model ResourceChunk {
  id             String                   @id @default(uuid())
  resourceId     String
  version        Int                      @default(1)
  subjectId      String?
  topicId        String?
  chunkType      ResourceChunkType
  chunkIndex     Int
  title          String?
  content        String
  tokenEstimate  Int
  pageStart      Int?
  pageEnd        Int?
  questionNumber String?
  contentHash    String
  searchText     String?
  searchVector   Unsupported("tsvector")?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  resource   Resource                 @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  subject    Subject?                 @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic      Topic?                   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  embeddings ResourceChunkEmbedding[]
  citations  AiMessageCitation[]

  @@unique([resourceId, version, chunkIndex], map: "ResourceChunk_resourceId_version_chunkIndex_key")
  @@index([resourceId, version, chunkType, chunkIndex], map: "ResourceChunk_resourceId_version_chunkType_chunkIndex_idx")
  @@index([subjectId, topicId, chunkType], map: "ResourceChunk_subjectId_topicId_chunkType_idx")
  @@index([contentHash], map: "ResourceChunk_contentHash_idx")
}

model ResourceEmbeddingConfiguration {
  id                  String                               @id @default(uuid())
  provider            String
  model               String
  dimensions          Int
  embeddingVersion    Int                                  @default(1)
  status              ResourceEmbeddingConfigurationStatus @default(BUILDING)
  eligibleChunkCount  Int                                  @default(0)
  completedChunkCount Int                                  @default(0)
  failedChunkCount    Int                                  @default(0)
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt
  activatedAt         DateTime?
  retiredAt           DateTime?

  embeddings        ResourceChunkEmbedding[]
  groundingAttempts AiGroundingAttempt[]

  @@unique([provider, model, dimensions, embeddingVersion], map: "ResourceEmbeddingConfig_provider_model_dim_ver_key")
  @@index([status, provider, model, dimensions, embeddingVersion], map: "ResourceEmbeddingConfig_status_provider_model_idx")
}

model ResourceChunkEmbedding {
  id              String                             @id @default(uuid())
  resourceChunkId String
  configurationId String
  contentHash     String
  status          ResourceChunkEmbeddingStatus       @default(PENDING)
  failureCode     ResourceChunkEmbeddingFailureCode?
  attemptCount    Int                                @default(0)
  leasedUntil     DateTime?
  embedding       Unsupported("vector")?
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt
  completedAt     DateTime?

  resourceChunk ResourceChunk                  @relation(fields: [resourceChunkId], references: [id], onDelete: Cascade)
  configuration ResourceEmbeddingConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@unique([resourceChunkId, configurationId, contentHash], map: "ResourceChunkEmbedding_chunk_config_hash_key")
  @@index([configurationId, status, leasedUntil, updatedAt, id], map: "ResourceChunkEmbedding_config_status_lease_idx")
  @@index([resourceChunkId, configurationId, status], map: "ResourceChunkEmbedding_chunk_config_status_idx")
  @@index([contentHash], map: "ResourceChunkEmbedding_contentHash_idx")
}

model PastQuestionSource {
  id          String   @id @default(uuid())
  paperYear   Int
  paperPdfUrl String?
  importedBy  String
  importedAt  DateTime @default(now())

  @@ignore
}

// =========================================================
//  PAYMENTS (LOGS)
// =========================================================

model Transaction {
  id        String   @id @default(uuid())
  userId    String?
  amount    Float
  currency  String   @default("NGN")
  status    String
  reference String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([reference], map: "Transaction_reference_key")
}
